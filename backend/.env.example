# Copy this file to .env and fill in real values. Never commit .env to GitHub.

# SQLite by default. For Postgres use:
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeai
DATABASE_URL=sqlite:///./resumeai.db

# Generate a strong random string for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed frontend origins, or * for all (dev only)
CORS_ORIGINS=*
